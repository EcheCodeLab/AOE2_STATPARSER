+    cols = [
+        "event_id",
+        "match_id",
+        "t_ms",
+        "time_sec",
+        "player_id",
+        "player_name",
+        "action_type",
+        "action_family",
+        "event_type_semantic",
+        "event_label",
+        "x",
+        "y",
+        "payload_json",
+    ]
+    if events_df.empty or "event_type_semantic" not in events_df.columns:
+        return pd.DataFrame(columns=cols)
+    out = events_df[events_df["event_type_semantic"] == "other"].copy()
+    keep = [c for c in cols if c in out.columns]
+    return out[keep]
